# Configuration is read from the project root, independent of caller cwd.
# Model API configuration; separate from the browser egress proxy below.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
VISION_MODEL=gpt-4.1

# Required browser-only egress. Choose warp or tailscale explicitly.
# Match the brocode.infra.egress service --mode; no automatic fallback.
# warp requires a separately configured loopback WARP upstream.
# tailscale requires an explicit IPv4 --source-ip and scoped routing; see docs.
# warp needs no source address.
BROCODE_PROXY_URL=http://127.0.0.1:1088
BROCODE_EGRESS_MODE=warp
BROCODE_CHROME_PATH=/usr/bin/google-chrome
BROCODE_DISPLAY=:99

# Optional absolute paths. Defaults stay within the project.
# BROCODE_ROOT=/absolute/path/to/brocode
# BROCODE_STATE_DIR=/absolute/path/to/brocode/var
# CHROME_USER_DATA_DIR=/absolute/path/to/brocode/.chrome_profile

# Automatic CAPTCHA solving and website upload dispatch are disabled.
# Local upload registration does not authorize sending a file to a website.
